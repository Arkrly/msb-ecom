# Database Configuration
MONGO_DB_USERNAME=root
MONGO_DB_PASSWORD=password
MONGO_DB_NAME=product-service
MONGO_PORT=27017

MYSQL_ROOT_PASSWORD=mysql
MYSQL_PORT=3306

# Postgres for Keycloak (Recommended for production, though tutorial might use MySQL)
# Using MySQL for Keycloak as per tutorial hints, or dedicated DB. 
# actually tutorial Part 4 says Keycloak with MySQL. 
# I'll stick to a separate schema in the same MySQL or just dev mode for simplicity unless specified.
# Let's use a separate container for Keycloak DB to avoid coupling if we can, or just dev mode (start-dev).
# For cloud readiness, let's use a postgres container for Keycloak as it's the default/preferred for Keycloak images usually.
# Wait, user context said "Keycloak setup with MySQL". I will use MySQL settings for Keycloak too if needed, 
# but simply running Keycloak in dev mode is easier for now. 
# However, "deploy to cloud" implies persistence.
# I will add a Postgres service for Keycloak to be robust.
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=password
POSTGRES_DB=keycloak
KEYCLOAK_DB_VENDOR=postgres
KEYCLOAK_DB_ADDR=postgres
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=password
KEYCLOAK_PORT=8181
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Kafka Configuration
KAFKA_PORT=9092
SCHEMA_REGISTRY_PORT=8081
KAFKA_UI_PORT=8080

# Mail Configuration
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Auth Service Configuration
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=password
AUTH_DB_NAME=auth_service
AUTH_SERVICE_PORT=8085
